{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "240000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(/tmp/**)",
      "Write(/tmp/claude/**)",
      "Bash(basename:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(rtk diff:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(rtk find:*)",
      "Bash(git add:*)",
      "Bash(rtk git add:*)",
      "Bash(git blame:*)",
      "Bash(rtk git blame:*)",
      "Bash(git commit:*)",
      "Bash(rtk git commit:*)",
      "Bash(git diff:*)",
      "Bash(rtk git diff:*)",
      "Bash(git log:*)",
      "Bash(rtk git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(rtk git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(rtk git show:*)",
      "Bash(git status:*)",
      "Bash(rtk git status:*)",
      "Bash(git tag:*)",
      "Bash(rtk git tag:*)",
      "Bash(grep:*)",
      "Bash(rtk grep:*)",
      "Bash(head:*)",
      "Bash(kubectl get:*)",
      "Bash(rtk kubectl get:*)",
      "Bash(kubectl logs:*)",
      "Bash(rtk kubectl logs:*)",
      "Bash(ls:*)",
      "Bash(rtk ls:*)",
      "Bash(mkdir:*)",
      "Bash(pwd:*)",
      "Bash(realpath:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(pnpm jest:*)",
      "Bash(rtk pnpm jest:*)",
      "Bash(pnpm why:*)",
      "Bash(rtk pnpm why:*)",
      "Bash(wc:*)",
      "Bash(rtk wc:*)",
      "Bash(which:*)",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__claude_ai_Notion__notion-fetch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/timu/.claude/hooks/gsd-session-state.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/timu/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/timu/.claude/hooks/tmux-window-title.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/timu/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ce@claude-essentials": true,
    "skill-creator@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-essentials": {
      "source": {
        "source": "github",
        "repo": "rileyhilliard/claude-essentials"
      },
      "autoUpdate": true
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "npm.pkg.github.com",
        "raw.githubusercontent.com",
        "pkg-npm.githubusercontent.com",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/pre-commit/"
      ]
    },
    "autoAllow": true
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "plansDirectory": ".claude/plans",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "verbose": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen"
}
