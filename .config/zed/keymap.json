// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "escape": null
    }
  },
  {
    "context": "ProjectSearchView",
    "bindings": {
      "escape": null
    }
  },
  {
    "context": "ProjectSearchBar || ProjectSearchView",
    "bindings": {
      "escape": "pane::CloseActiveItem",
      "ctrl-g": "pane::CloseActiveItem"
    }
  },
  {
    "context": "!ProjectSearchBar && !ProjectSearchView",
    "bindings": {
      "ctrl-g": "pane::DeploySearch"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space g": "file_finder::Toggle",
      "space f": "file_finder::Toggle",
      "space r r": "projects::OpenRecent",
      "g o": "vim::PushSneak"
      //     "tab": "vim::SelectNextSyntaxNode"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-x": "vim::Exchange",
      "shift-s": "vim::PushAddSurrounds"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "f2": "editor::ToggleBreakpoint"
    }
  },
  {
    "bindings": {
      "f7": "debugger::StepInto",
      "f8": "debugger::StepOver",
      "f9": "debugger::Start",
      "ctrl-z": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-1": "project_panel::ToggleFocus"
    }
  }
]
