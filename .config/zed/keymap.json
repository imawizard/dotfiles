// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "escape": null
    }
  },
  {
    "context": "ProjectSearchView",
    "bindings": {
      "escape": null
    }
  },
  {
    "context": "ProjectSearchBar || ProjectSearchView",
    "bindings": {
      "escape": "pane::CloseActiveItem",
      "ctrl-g": "pane::CloseActiveItem"
    }
  },
  {
    "context": "!ProjectSearchBar && !ProjectSearchView",
    "bindings": {
      "ctrl-g": "pane::DeploySearch"
    }
  },
  // {
  //   "context": "vim_mode == insert",
  //   "bindings": {
  //     "tab": "vim::SelectNextSyntaxNode"
  //   }
  // },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space g": "file_finder::Toggle",
      "space f": "file_finder::Toggle",
      "g o": "vim::PushSneak"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "f2": "editor::ToggleBreakpoint"
    }
  },
  {
    "bindings": {
      "f9": "debugger::Start"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": { "shift-x": "vim::Exchange" }
  },
  {
    "context": "vim_mode == visual",
    "bindings": { "shift-s": "vim::PushAddSurrounds" }
  },
  {
    "bindings": {
      "f7": "debugger::StepInto"
    }
  },
  {
    "bindings": {
      "f8": "debugger::StepOver"
    }
  }
]
