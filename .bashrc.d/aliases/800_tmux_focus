# Focus a pane running a specified command.
tmux_focus() {
    if [[ $1 == "--help" || $# -lt 1 ]]; then
        echo "usage: $0 prog-name"
        return 1
    fi

    local session=$(
        [[ $TMUX ]] &&
            tmux display-message -p '#{session_name}' ||
            echo '[^ ]+'
    )
    local panes=$(tmux list-panes -a -F '#{pane_current_command} #{session_name} #{window_id} #{pane_id}')
    local match=$(echo $panes | awk '/^'$1' '$session' / {print $3" "$4; exit}')

    # Try again without filtering for the current session.
    [[ ! $match ]] && match=$(echo $panes | awk '/^'$1' / {print $3" "$4; exit}')

    local window_id="${match%% *}"
    local pane_id="${match##* }"

    if [[ $window_id && $pane_id ]]; then 
        tmux select-window -t "$window_id" &&
            tmux select-pane -t "$pane_id"
    else
        echo "pane not found" >&2
    fi
}
